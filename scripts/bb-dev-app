#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="${BB_DEV_REPO_ROOT:-$(dirname -- "${script_dir}")}"

resolve_dev_node_bin_dir() {
  if [[ -n "${BB_DEV_NODE_BIN_DIR:-}" ]]; then
    printf '%s\n' "${BB_DEV_NODE_BIN_DIR}"
    return
  fi

  local current_major
  current_major="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || true)"
  if [[ "${current_major}" == "22" ]]; then
    return
  fi

  local node_versions_dir="${NVM_DIR:-${HOME}/.nvm}/versions/node"
  [[ -d "${node_versions_dir}" ]] || return 0

  node - "${node_versions_dir}" <<'NODE' || true
const fs = require("node:fs");
const path = require("node:path");

const nodeVersionsDir = process.argv[2];
const candidates = fs
  .readdirSync(nodeVersionsDir, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => {
    const match = /^v(\d+)\.(\d+)\.(\d+)$/.exec(entry.name);
    if (match === null) {
      return null;
    }
    return {
      name: entry.name,
      major: Number(match[1]),
      minor: Number(match[2]),
      patch: Number(match[3]),
    };
  })
  .filter(
    (version) =>
      version !== null &&
      version.major === 22 &&
      (version.minor > 12 || (version.minor === 12 && version.patch >= 0)),
  )
  .sort((left, right) => {
    if (left.minor !== right.minor) return left.minor - right.minor;
    return left.patch - right.patch;
  });

const selected = candidates.at(-1);
if (selected !== undefined) {
  console.log(path.join(nodeVersionsDir, selected.name, "bin"));
}
NODE
}

dev_node_bin_dir="$(resolve_dev_node_bin_dir)"
if [[ -n "${dev_node_bin_dir}" ]]; then
  PATH="${dev_node_bin_dir}:${PATH}:${HOME}/.local/bin"
else
  # Append, never prepend: a node in ~/.local/bin must not shadow the node the
  # caller already resolved (nvm, mise, asdf, ...).
  PATH="${PATH}:${HOME}/.local/bin"
fi

sanitize_label() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9._-]+/-/g; s/^[._-]+//; s/[._-]+$//'
}

repo_label="${REPO_ROOT#$HOME/}"
if [[ "${repo_label}" == "${REPO_ROOT}" ]]; then
  repo_label="${REPO_ROOT}"
fi

LAUNCHER_NAME="${BB_DEV_LAUNCHER_NAME:-$(sanitize_label "${repo_label}")}"
if [[ -z "${LAUNCHER_NAME}" ]]; then
  LAUNCHER_NAME="bb"
fi

DEV_SESSION="bb-dev-app-${LAUNCHER_NAME}-dev"
DESKTOP_SESSION="bb-dev-app-${LAUNCHER_NAME}-desktop"
LOG_ROOT="${HOME}/.bb-dev/launchers/${LAUNCHER_NAME}"
DEV_LOG="${LOG_ROOT}/dev.log"
DESKTOP_LOG="${LOG_ROOT}/desktop.log"
LAUNCHER_LOG="${LOG_ROOT}/launcher.log"
DEV_PIDFILE="${LOG_ROOT}/dev.pid"

usage() {
  cat <<'EOF'
Usage:
  By default these start only the source dev server (web frontend, server, host
  daemon) and print the URL without opening a browser. Pass --open to open the
  browser after startup. Pass --desktop to also launch the Electron desktop shell.

  scripts/bb-dev-app main [--open] [--desktop]
      Fetch origin/main, switch this checkout to main, fast-forward, then start
      the source dev server (and the desktop shell with --desktop).

  scripts/bb-dev-app branch <branch> [--open] [--desktop]
      Switch this checkout to a local branch, or create it from origin/<branch>,
      then start the source dev server (and the desktop shell with --desktop).

  scripts/bb-dev-app current [--open] [--desktop]
      Start the source dev server for the current branch (and the desktop shell
      with --desktop).

  scripts/bb-dev-app stop
      Stop the launcher-managed dev server and desktop shell.

  scripts/bb-dev-app status
      Print branch, ports, process status, and useful URLs.

  scripts/bb-dev-app env
      Print shell exports for using pnpm bb:dev against this dev instance.

  scripts/bb-dev-app logs [dev|desktop|launcher]
      Follow launcher logs. Defaults to the dev server log.
EOF
}

log() {
  mkdir -p "${LOG_ROOT}"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" \
    | tee -a "${LAUNCHER_LOG}" >&2
}

die() {
  log "ERROR: $*"
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

assert_desktop_node_runtime() {
  local version exec_path
  version="$(node -p "process.version" 2>/dev/null || echo "unknown")"
  exec_path="$(command -v node || echo "unknown")"

  if ! node -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    process.exit(major === 22 && minor >= 19 ? 0 : 1);
  '; then
    die "Desktop dev requires Node 22.19 because Electron's postinstall runtime is not reliable on newer Node releases. Current node is ${version} at ${exec_path}. Install/use Node 22.19 or set BB_DEV_NODE_BIN_DIR to a Node 22.19 bin directory."
  fi
}

ensure_repo() {
  # Accept both a normal checkout (.git directory) and a linked worktree
  # (.git is a file pointing at the common git dir).
  [[ -e "${REPO_ROOT}/.git" ]] || die "Repo not found: ${REPO_ROOT}"
}

# Ports and paths come from @bb/config via `pnpm dev:config`, the same resolver
# `pnpm dev` uses. Recomputing them here is what let this script disagree with
# the stack it starts once BB_DEV_APP_PORT became overridable: `stop` then missed
# the real listener and the next `start` died on EADDRINUSE.
load_config() {
  local config
  if ! config="$(
    cd "${REPO_ROOT}" && pnpm run --silent dev:config 2>/dev/null \
      | grep -E '^[A-Z_]+='
  )"; then
    config=""
  fi

  if [[ -z "${config}" ]]; then
    die "Could not resolve the dev instance config via 'pnpm dev:config' in ${REPO_ROOT}. Run 'pnpm install' there, then retry."
  fi

  eval "${config}"
}

screen_session_exists() {
  local session="$1"
  local listing
  listing="$(screen -ls 2>/dev/null || true)"
  awk -v session=".${session}" 'index($0, session) > 0 { found = 1 } END { exit found ? 0 : 1 }' <<<"${listing}"
}

quit_screen_session() {
  local session="$1"
  if screen_session_exists "${session}"; then
    log "Stopping screen session ${session}"
    screen -S "${session}" -X quit || true
  fi
}

kill_pid_list() {
  local signal="$1"
  shift
  local pid
  local pids=()
  # Never pass 0 or 1 to kill: 0 signals the whole process group and 1 is init.
  for pid in "$@"; do
    [[ "${pid}" =~ ^[0-9]+$ ]] || continue
    (( pid > 1 )) && pids+=("${pid}")
  done
  (( ${#pids[@]} == 0 )) && return 0
  /bin/kill "-${signal}" "${pids[@]}" 2>/dev/null || true
}

port_listener_pids() {
  local port="$1"
  lsof -nP -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null | sort -u || true
}

port_state() {
  local port="$1"
  if [[ -n "$(port_listener_pids "${port}")" ]]; then
    printf 'listening'
  else
    printf 'not listening'
  fi
}

pid_is_alive() {
  /bin/kill -0 "$1" 2>/dev/null
}

pid_cwd() {
  lsof -a -d cwd -p "$1" -Fn 2>/dev/null \
    | awk '/^n/ { print substr($0, 2); exit }'
}

# Guards the ancestor walk below: a bare interactive shell is never part of a dev
# stack, so a hand-run `pnpm dev` must not let us climb into the user's terminal.
pid_is_interactive_shell() {
  local command basename_value
  command="$(ps -o command= -p "$1" 2>/dev/null)"
  [[ -n "${command}" ]] || return 1
  case "${command}" in
    *" "*) return 1 ;;
  esac
  basename_value="${command##*/}"
  basename_value="${basename_value#-}"
  case "${basename_value}" in
    sh | bash | zsh | ksh | csh | tcsh | dash | fish | login) return 0 ;;
    *) return 1 ;;
  esac
}

descendant_pids() {
  local root="$1"
  # Emitting via `order` (pids ps actually reported) rather than `for (pid in
  # selected)` is load-bearing: referencing selected[parent[pid]] creates that
  # key, so iterating the array would emit every ppid on the machine, pid 1
  # included.
  ps -axo pid=,ppid= | awk -v root="${root}" '
    { parent[$1] = $2; order[++count] = $1 }
    END {
      selected[root] = 1
      changed = 1
      while (changed) {
        changed = 0
        for (i = 1; i <= count; i++) {
          pid = order[i]
          if (selected[pid] != 1 && selected[parent[pid]] == 1) {
            selected[pid] = 1
            changed = 1
          }
        }
      }
      for (i = 1; i <= count; i++) {
        pid = order[i]
        if (selected[pid] == 1 && pid != root) print pid
      }
    }
  '
}

top_dev_ancestor() {
  local pid="$1"
  local parent
  while :; do
    parent="$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -dc '0-9')"
    [[ -n "${parent}" ]] || break
    (( parent <= 1 )) && break
    pid_is_interactive_shell "${parent}" && break
    [[ "$(pid_cwd "${parent}")" == "${REPO_ROOT}" ]] || break
    pid="${parent}"
  done
  printf '%s\n' "${pid}"
}

# `pnpm dev` fans out into dotenv -> cross-env -> run-dev -> turbo -> one process
# per app, and the host-daemon dev supervisor respawns children killed under a
# live parent. Stopping therefore has to start from the root of the tree, which
# survived `screen -X quit` as an orphan reparented to launchd.
dev_tree_root_pids() {
  local pid
  if [[ -f "${DEV_PIDFILE}" ]]; then
    pid="$(tr -dc '0-9' < "${DEV_PIDFILE}")"
    if [[ -n "${pid}" ]] && pid_is_alive "${pid}"; then
      printf '%s\n' "${pid}"
    fi
  fi

  while IFS= read -r pid; do
    [[ -n "${pid}" ]] || continue
    [[ "$(pid_cwd "${pid}")" == "${REPO_ROOT}" ]] || continue
    top_dev_ancestor "${pid}"
  done < <(pgrep -f 'packages/scripts/src/commands/run-dev\.ts' 2>/dev/null || true)
}

stop_dev_process_tree() {
  local roots=()
  local targets=()
  local pid descendant

  while IFS= read -r pid; do
    [[ -n "${pid}" ]] && roots+=("${pid}")
  done < <(dev_tree_root_pids | sort -u)

  (( ${#roots[@]} == 0 )) && return 0

  log "Stopping dev process tree from root(s): ${roots[*]}"
  for pid in "${roots[@]}"; do
    while IFS= read -r descendant; do
      [[ -n "${descendant}" ]] && targets+=("${descendant}")
    done < <(descendant_pids "${pid}")
  done

  # Roots first: killing a child under a live supervisor only makes it respawn.
  kill_pid_list TERM "${roots[@]}"
  sleep 1
  (( ${#targets[@]} > 0 )) && kill_pid_list TERM "${targets[@]}"
  sleep 2
  kill_pid_list KILL "${roots[@]}" ${targets[@]+"${targets[@]}"}
}

warn_about_held_dev_ports() {
  local port pids
  local held=()
  for port in "${BB_DEV_APP_PORT}" "${BB_SERVER_PORT}" "${BB_HOST_DAEMON_PORT}"; do
    pids="$(port_listener_pids "${port}" | tr '\n' ' ')"
    [[ -n "${pids// /}" ]] && held+=("${port} (pid ${pids% })")
  done

  (( ${#held[@]} == 0 )) && return 0
  log "WARNING: dev ports still held after stop: ${held[*]}"
  log "The next start will fail with EADDRINUSE until those processes exit."
}

desktop_pids() {
  ps -axo pid=,command= \
    | awk -v user_data="--user-data-dir=${DESKTOP_USER_DATA_DIR}" '
        index($0, user_data) > 0 { print $1 }
      ' \
    | sort -u
}

stop_dev_app() {
  load_config

  quit_screen_session "${DESKTOP_SESSION}"
  quit_screen_session "${DEV_SESSION}"

  sleep 2

  stop_dev_process_tree
  rm -f "${DEV_PIDFILE}"

  # Backstop for anything the tree walk cannot reach: a stack started outside
  # this launcher, or a desktop shell left behind by a previous run.
  local pids=()
  local pid
  while IFS= read -r pid; do
    [[ -n "${pid}" ]] && pids+=("${pid}")
  done < <(
    {
      port_listener_pids "${BB_DEV_APP_PORT}"
      port_listener_pids "${BB_SERVER_PORT}"
      port_listener_pids "${BB_HOST_DAEMON_PORT}"
      desktop_pids
    } | sort -u
  )

  if (( ${#pids[@]} > 0 )); then
    log "Stopping remaining dev-instance processes: ${pids[*]}"
    kill_pid_list TERM "${pids[@]}"
    sleep 2
    kill_pid_list KILL "${pids[@]}"
  fi

  warn_about_held_dev_ports
}

handle_dirty_work_before_branch_switch() {
  if [[ -z "$(git -C "${REPO_ROOT}" status --porcelain)" ]]; then
    return
  fi

  if [[ "${BB_DEV_APP_STASH_DIRTY:-0}" != "1" ]]; then
    log "Leaving dirty checkout in place before branch switch; git will stop if files conflict"
    return
  fi

  local stash_msg="bb-dev-app-auto-stash-$(date '+%Y%m%d-%H%M%S')"
  log "Stashing dirty checkout before branch switch: ${stash_msg}"
  git -C "${REPO_ROOT}" stash push -u -m "${stash_msg}" >/dev/null
}

switch_to_main() {
  stop_dev_app
  handle_dirty_work_before_branch_switch
  log "Fetching origin/main"
  git -C "${REPO_ROOT}" fetch origin main
  log "Switching to main"
  git -C "${REPO_ROOT}" switch main
  log "Fast-forwarding main from origin/main"
  git -C "${REPO_ROOT}" pull --ff-only origin main
}

switch_to_branch() {
  local branch="$1"
  [[ -n "${branch}" ]] || die "Branch name is required"
  [[ "${branch}" != "--open" ]] || die "Branch name is required"

  stop_dev_app
  handle_dirty_work_before_branch_switch
  log "Fetching origin"
  git -C "${REPO_ROOT}" fetch origin
  if git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/heads/${branch}"; then
    log "Switching to local branch ${branch}"
    git -C "${REPO_ROOT}" switch "${branch}"
  elif git -C "${REPO_ROOT}" show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
    log "Creating local branch ${branch} from origin/${branch}"
    git -C "${REPO_ROOT}" switch --track -c "${branch}" "origin/${branch}"
  else
    log "Switching to branch ${branch}"
    git -C "${REPO_ROOT}" switch "${branch}"
  fi
  if git -C "${REPO_ROOT}" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    log "Fast-forwarding ${branch} from its upstream"
    git -C "${REPO_ROOT}" pull --ff-only
  fi
}

ensure_dependencies() {
  log "Installing workspace dependencies"
  pnpm -C "${REPO_ROOT}" install --frozen-lockfile

  log "Checking native Node modules"
  node "${REPO_ROOT}/scripts/ensure-native-modules.mjs"

  # Official catalog installs execute the packaged plugin SDK at runtime.
  # Build it before source dev starts so a clean worktree can install a plugin.
  log "Building plugin SDK runtime"
  pnpm -C "${REPO_ROOT}" exec turbo run build --filter=@get-bb/plugin-sdk

  if ! (cd "${REPO_ROOT}/apps/desktop" && node -e "require('electron')" >/dev/null 2>&1); then
    local electron_install
    electron_install="$(
      find "${REPO_ROOT}/node_modules/.pnpm" -path '*/node_modules/electron/install.js' -type f -print -quit
    )"
    [[ -n "${electron_install}" ]] || die "Could not find Electron install.js"
    log "Installing Electron runtime"
    node "${electron_install}"
  fi
}

wait_for_log_pattern() {
  local file="$1"
  local pattern="$2"
  local label="$3"
  local timeout_seconds="$4"
  local elapsed=0
  while (( elapsed < timeout_seconds )); do
    if [[ -f "${file}" ]] && grep -q "${pattern}" "${file}"; then
      return 0
    fi
    if [[ -f "${file}" ]] && grep -q "port .* is unavailable\\|ELIFECYCLE\\|ERROR  run failed" "${file}"; then
      die "${label} failed; see ${file}"
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  die "Timed out waiting for ${label}; see ${file}"
}

start_dev_server() {
  local repo_root_q path_q dev_log_q dev_pidfile_q
  printf -v repo_root_q '%q' "${REPO_ROOT}"
  printf -v path_q '%q' "${PATH}"
  printf -v dev_log_q '%q' "${DEV_LOG}"
  printf -v dev_pidfile_q '%q' "${DEV_PIDFILE}"
  log "Starting dev server session ${DEV_SESSION}"
  rm -f "${DEV_LOG}" "${DEV_PIDFILE}"
  # `exec` keeps the recorded pid valid: this shell becomes the `pnpm dev` root,
  # which is the handle `stop` needs when screen dies and the tree is orphaned.
  screen -dmS "${DEV_SESSION}" "${BASH}" -lc "cd ${repo_root_q} && export PATH=${path_q} && unset BB_THREAD_ID BB_ENVIRONMENT_ID BB_THREAD_STORAGE && echo \$\$ > ${dev_pidfile_q} && exec pnpm dev > ${dev_log_q} 2>&1"
  wait_for_log_pattern "${DEV_LOG}" "Host daemon started" "dev server" 90
}

start_desktop() {
  local repo_root_q path_q desktop_log_q
  printf -v repo_root_q '%q' "${REPO_ROOT}"
  printf -v path_q '%q' "${PATH}"
  printf -v desktop_log_q '%q' "${DESKTOP_LOG}"
  log "Starting desktop session ${DESKTOP_SESSION}"
  rm -f "${DESKTOP_LOG}"
  # The dotenv wrapper is what `pnpm dev` gets from its own script; without it
  # the desktop shell resolves a different app port than the server it attaches
  # to whenever an env file overrides BB_DEV_APP_PORT.
  screen -dmS "${DESKTOP_SESSION}" "${BASH}" -lc "cd ${repo_root_q} && export PATH=${path_q} && unset BB_THREAD_ID BB_ENVIRONMENT_ID BB_THREAD_STORAGE && exec pnpm exec dotenv -c development -- pnpm exec turbo run dev --filter=@bb/desktop > ${desktop_log_q} 2>&1"
  wait_for_log_pattern "${DESKTOP_LOG}" "@bb/desktop: app http://localhost:${BB_DEV_APP_PORT}" "desktop app" 120
}

open_app_url() {
  local url="http://localhost:${BB_DEV_APP_PORT}"
  if command -v open >/dev/null 2>&1; then
    open "${url}" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "${url}" >/dev/null 2>&1 || true
  elif command -v gio >/dev/null 2>&1; then
    gio open "${url}" >/dev/null 2>&1 || true
  fi
}

start_current() {
  local open_after_start="$1"
  local start_desktop_app="$2"
  [[ "${start_desktop_app}" == "1" ]] && assert_desktop_node_runtime
  stop_dev_app
  ensure_dependencies
  load_config
  start_dev_server
  [[ "${start_desktop_app}" == "1" ]] && start_desktop
  [[ "${open_after_start}" == "1" ]] && open_app_url
  status
}

status() {
  load_config
  local branch head codex_version
  branch="$(git -C "${REPO_ROOT}" branch --show-current 2>/dev/null || true)"
  head="$(git -C "${REPO_ROOT}" rev-parse --short HEAD 2>/dev/null || true)"
  codex_version="$(codex --version 2>/dev/null || true)"

  printf 'Repo: %s\n' "${REPO_ROOT}"
  printf 'Branch: %s (%s)\n' "${branch:-detached}" "${head:-unknown}"
  printf 'Codex: %s\n' "${codex_version:-not found}"
  printf 'Instance: %s\n' "${INSTANCE_ID}"
  printf 'Data dir: %s\n' "${DATA_DIR}"
  printf 'App: http://localhost:%s (%s)\n' \
    "${BB_DEV_APP_PORT}" "$(port_state "${BB_DEV_APP_PORT}")"
  printf 'Server: %s (%s)\n' \
    "${BB_SERVER_URL}" "$(port_state "${BB_SERVER_PORT}")"
  printf 'Host daemon: http://127.0.0.1:%s (%s)\n' \
    "${BB_HOST_DAEMON_PORT}" "$(port_state "${BB_HOST_DAEMON_PORT}")"
  printf 'Desktop user data: %s\n' "${DESKTOP_USER_DATA_DIR}"
  printf 'Dev session: %s\n' "$(screen_session_exists "${DEV_SESSION}" && echo running || echo stopped)"
  printf 'Desktop session: %s\n' "$(screen_session_exists "${DESKTOP_SESSION}" && echo running || echo stopped)"
  printf 'Logs: %s, %s\n' "${DEV_LOG}" "${DESKTOP_LOG}"
}

print_env() {
  load_config
  cat <<EOF
export BB_SERVER_URL=${BB_SERVER_URL}
export BB_HOST_DAEMON_PORT=${BB_HOST_DAEMON_PORT}
export BB_PROJECT_ID=proj_personal
unset BB_THREAD_ID
unset BB_ENVIRONMENT_ID
unset BB_THREAD_STORAGE
EOF
}

follow_logs() {
  local target="${1:-dev}"
  case "${target}" in
    dev) tail -f "${DEV_LOG}" ;;
    desktop) tail -f "${DESKTOP_LOG}" ;;
    launcher) tail -f "${LAUNCHER_LOG}" ;;
    *) die "Unknown log target: ${target}" ;;
  esac
}

main() {
  require_command git
  require_command node
  require_command pnpm
  require_command screen
  require_command lsof
  ensure_repo
  mkdir -p "${LOG_ROOT}"

  local command="${1:-}"
  (( $# > 0 )) && shift
  local open_after_start="0"
  local start_desktop_app="0"
  local positional=()
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --open) open_after_start="1" ;;
      --desktop) start_desktop_app="1" ;;
      *) positional+=("${arg}") ;;
    esac
  done

  case "${command}" in
    main)
      switch_to_main
      start_current "${open_after_start}" "${start_desktop_app}"
      ;;
    branch)
      switch_to_branch "${positional[0]:-}"
      start_current "${open_after_start}" "${start_desktop_app}"
      ;;
    current)
      start_current "${open_after_start}" "${start_desktop_app}"
      ;;
    stop)
      stop_dev_app
      ;;
    status)
      status
      ;;
    env)
      print_env
      ;;
    logs)
      follow_logs "${positional[0]:-dev}"
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      usage
      die "Unknown command: ${command}"
      ;;
  esac
}

main "$@"
